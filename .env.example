# ==============================================================================
# SpikeAI / Narratium 全栈环境配置示例模板
# ==============================================================================

# --- 基础运行环境 ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key!

# --- 数据库配置 (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=spikeai
POSTGRES_PASSWORD=spikeai_password
POSTGRES_DB=spikeai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://spikeai:spikeai_password@localhost:5432/spikeai_db

# --- Redis 7 缓存与分布式锁 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=spikeai_redis_pass
REDIS_DB=0
REDIS_URL=redis://:spikeai_redis_pass@localhost:6379/0

# --- JWT 认证与安全 ---
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_spikeai_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7天

# --- 大模型渠道 API Keys (按需配置) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- 存储与上传 ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
